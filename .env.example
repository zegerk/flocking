# Cloudflare deploy credentials.
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
# Create a token: Cloudflare Dashboard -> My Profile -> API Tokens ->
#   "Edit Cloudflare Workers" template -> select the target account.
CLOUDFLARE_API_TOKEN=

# The account this project deploys to. Find it with `npx wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=