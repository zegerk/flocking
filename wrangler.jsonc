{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "friends-and-enemies",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "flocking.zeger.app",
      "custom_domain": true
    }
  ]
}